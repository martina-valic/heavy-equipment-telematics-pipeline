# Copy to .env and adjust as needed. Never commit .env.

# --- Module 1: Telemetry Simulator ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TELEMETRY_TOPIC=telematics.equipment.telemetry.v1
TELEMETRY_DLQ_TOPIC=telematics.equipment.telemetry.dlq.v1
EMIT_INTERVAL_SECONDS=5
# Share of messages that get a data-quality anomaly injected (0.05 - 0.10)
ANOMALY_RATE=0.075
# Optional: set an integer for reproducible runs
SIMULATOR_SEED=

# --- Module 2: Streaming Ingestion (Kafka Connect -> Snowflake Bronze) ---
KAFKA_CONNECT_URL=http://localhost:8083
# Account identifier in orgname-accountname form
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=TELEMATICS_KAFKA_CONNECTOR
SNOWFLAKE_ROLE=TELEMATICS_INGEST_ROLE
SNOWFLAKE_WAREHOUSE=TELEMATICS_WH
SNOWFLAKE_DATABASE=TELEMATICS
SNOWFLAKE_BRONZE_SCHEMA=BRONZE
# Written by 02_streaming_ingestion/snowflake/generate_keypair.py: base64 body of
# secrets/snowflake_rsa_key.p8 with no header, footer or line breaks. Never commit.
SNOWFLAKE_PRIVATE_KEY=
# End-to-end target: Kafka produce -> row queryable in Bronze
INGESTION_SLA_SECONDS=120

# --- Module 3: Legacy PostgreSQL + Debezium CDC ---
# Host-side connection (legacy_activity.py, tests). Containers reach the database as postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telematics_legacy
# Superuser the container initialises the database with
POSTGRES_USER=telematics_admin
# Debezium replication user (REPLICATION + SELECT on the captured tables)
POSTGRES_CDC_USER=debezium_cdc
# Legacy application user (DML on the fleet tables)
POSTGRES_APP_USER=legacy_app
# Written by 03_cdc_migration/postgres/generate_passwords.py. Never commit.
POSTGRES_PASSWORD=
POSTGRES_CDC_PASSWORD=
POSTGRES_APP_PASSWORD=
# Seconds between legacy_activity.py transactions
LEGACY_ACTIVITY_INTERVAL_SECONDS=10
